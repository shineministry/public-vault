name = "public-vault"
main = "worker-public.js"
compatibility_date = "2024-01-01"

[[r2_buckets]]
binding = "PUBLIC_VAULT_BUCKET"
bucket_name = "public-vault-bucket" # CREATE EMPTY - you will put R2 - never reuse private SOV bucket

[vars]
ALLOWED_ORIGIN_PUBLIC = "https://your-public-domain.com"

# Secrets (wrangler secret put - never commit):
# PUBLIC_JWT_SECRET, STRIPE_SECRET, STRIPE_WEBHOOK_SECRET, FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, GEMINI_API_KEY, GROQ_API_KEY
